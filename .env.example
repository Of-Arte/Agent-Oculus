# Required: Public.com API secret key (from https://public.com/settings/security/api)
# The agent exchanges this secret key for a short-lived access token at runtime.
PUBLIC_API_SECRET_KEY=your_secret_key_here

# Required: WorldMonitor base URL (self-hosted or managed instance)
WM_BASE_URL=http://your-worldmonitor-host:8000

# Optional: WorldMonitor API key (if your WorldMonitor instance requires auth)
# Comment out or leave empty if your instance does not require authentication.
# WORLDMONITOR_API_KEY=

# No execution features - this profile is read-only by design.
